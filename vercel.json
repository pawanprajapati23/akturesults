{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "akturesults.in"
        }
      ],
      "destination": "https://www.akturesults.in/:path*",
      "permanent": true
    },
    {
      "source": "/aktu-erp-login-guide.html",
      "destination": "/results/aktu-erp-login-result-2026.html",
      "permanent": true
    },
    {
      "source": "/aktu-one-view-result-2026.html",
      "destination": "/results/aktu-one-view-result-2026.html",
      "permanent": true
    },
    {
      "source": "/aktu-result-server-down.html",
      "destination": "/results/aktu-result-server-down.html",
      "permanent": true
    },
    {
      "source": "/aktu-results.html",
      "destination": "/results/",
      "permanent": true
    },
    {
      "source": "/cuet-aktu-admission-guide.html",
      "destination": "/admissions/aktu-lateral-entry-btech-guide-2026.html",
      "permanent": true
    },
    {
      "source": "/uptac-counselling-2026.html",
      "destination": "/admissions/uptac-counselling-2026.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp|css|js|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
